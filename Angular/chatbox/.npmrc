; registry.npmjs.org is blocked by the corporate Cisco Umbrella web gateway, and
; the old corporate host wal-artifactory.rocketsoftware.com no longer resolves.
; Using the public npmmirror.com mirror, which the gateway allows and which hosts
; its own tarballs. Switch back to your corporate Artifactory if/when available.
registry=https://registry.npmmirror.com/
legacy-peer-deps=true
strict-ssl=false
